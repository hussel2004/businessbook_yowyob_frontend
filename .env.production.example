# =============================================================================
# BUSINESSBOOK FRONTEND - Production Environment Variables
# =============================================================================
# Copy this to .env.production.local and fill in your values
# Or set these as environment variables in Railway

# API Configuration
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app/api
NEXT_PUBLIC_APP_URL=https://your-frontend.up.railway.app

# Environment
NODE_ENV=production

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Sentry for error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx
